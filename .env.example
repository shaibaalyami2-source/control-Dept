# --- AI provider (server-side only; NEVER put keys in front-end code) ---
# Claude: set ANTHROPIC_API_KEY (from console.anthropic.com). It is used when present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Force a provider explicitly: anthropic | gemini  (default: Claude if its key exists, else Gemini)
AI_PROVIDER=

# --- Gemini (used when no Anthropic key is set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
# "interactions" (default, required by the newest models) or "generate" (older models)
GEMINI_API=interactions
# minimal | low | medium | high  (low = fast replies)
GEMINI_THINKING_LEVEL=low

# --- Supabase (used to verify the signed-in user before every AI request) ---
SUPABASE_URL=https://rynlnxnkofwyileuwqce.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_jqTBQAbPMhQ0qn8_RcGp2w_guHOoe7W

# --- Server ---
PORT=3000
# Only needed if the front-end is hosted on a different origin than this server (comma separated)
ALLOWED_ORIGINS=
# Per-user limits
AI_RATE_PER_MINUTE=15
AI_RATE_PER_DAY=300

# --- Phone notifications (Web Push). Generate keys with: node scripts/generate-vapid.js ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random secret that Supabase webhooks send in the x-webhook-secret header
PUSH_WEBHOOK_SECRET=
# SECRET, server only (Supabase → Project Settings → API → service_role). Never put it in front-end code.
SUPABASE_SERVICE_ROLE_KEY=
# Who is told about a new report (profile roles, comma separated)
PUSH_REPORT_ROLES=admin,supervisor

# Grok (xAI): setting XAI_API_KEY switches the assistant to Grok. XAI_MODEL = a model id from your xAI console.
# XAI_API_KEY=
# XAI_MODEL=grok-4
