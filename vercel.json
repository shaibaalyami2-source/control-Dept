{
  "outputDirectory": "public",
  "buildCommand": "",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "{server/knowledge/**,data/**}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=/api/:path*" },
    { "source": "/v/:id", "destination": "/api/index?__p=/v/:id" }
  ]
}
